{
  "name": "@teamnova-sri-ko-lms/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Automated test suite (unit, integration, E2E, performance, security) for the SRI-KO Learning Management System \u2014 SENG 34213 System Development Project.",
  "author": "TeamNova \u2014 University of Kelaniya, Software Engineering Teaching Unit",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "sut:setup": "node scripts/setup-sut.js",
    "sut:verify": "node scripts/verify-sut.js",
    "sut:endpoints": "node scripts/extract-endpoints.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:frontend",
    "test:unit": "jest --selectProjects unit --config config/jest.config.js",
    "test:unit:watch": "jest --selectProjects unit --config config/jest.config.js --watch",
    "test:integration": "jest --selectProjects integration --config config/jest.config.js",
    "test:security": "jest --selectProjects security --config config/jest.config.js --runInBand",
    "test:frontend": "vitest run --config config/vitest.config.mjs",
    "test:frontend:watch": "vitest --config config/vitest.config.mjs",
    "test:e2e": "playwright test --config config/playwright.config.js",
    "test:e2e:ui": "playwright test --config config/playwright.config.js --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:perf": "node scripts/run-performance.js",
    "test:perf:smoke": "node scripts/run-performance.js --scenario smoke",
    "test:perf:load": "node scripts/run-performance.js --scenario load",
    "test:perf:stress": "node scripts/run-performance.js --scenario stress",
    "test:perf:spike": "node scripts/run-performance.js --scenario spike",
    "coverage": "npm run coverage:backend && npm run coverage:frontend && npm run coverage:merge",
    "coverage:backend": "jest --selectProjects unit integration security --config config/jest.config.js --coverage",
    "coverage:frontend": "vitest run --config config/vitest.config.mjs --coverage",
    "coverage:merge": "node scripts/merge-coverage.js",
    "coverage:check": "node scripts/check-coverage.js",
    "report:endpoints": "node scripts/check-endpoint-coverage.js",
    "report:register": "node scripts/generate-test-register.js",
    "report:traceability": "node scripts/generate-traceability.js",
    "report:owasp": "node scripts/generate-owasp-report.js",
    "report:all": "npm run report:endpoints && npm run report:register && npm run report:traceability && npm run report:owasp",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:deps": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run format:check && npm run test:all && npm run coverage:check && npm run report:endpoints",
    "clean": "node -e \"require('fs').rmSync('reports',{recursive:true,force:true});require('fs').mkdirSync('reports')\""
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "axios": "^1.20.0",
    "axios-mock-adapter": "^2.1.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jsdom": "^25.0.1",
    "mongodb-memory-server": "^10.4.3",
    "nyc": "^17.1.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "supertest": "^7.2.2",
    "vitest": "^2.1.9"
  }
}
