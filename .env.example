# ─────────────────────────────────────────────────────────────────────────────
#  SRI-KO LMS — Test Suite Environment
#
#  SENG 34213 §7 "Secrets Management": copy this file to `.env` (git-ignored)
#  for local development, and configure the same names as GitHub Secrets or
#  repository variables for CI. Never commit a real secret, private repository
#  or not.
#
#      cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Locating the application under test ──────────────────────────────────────
# The suite lives in its own repository, so it needs the application checked
# out somewhere it can reach. Leave this unset to use the auto-discovery order
# in testing.config.js — which finds ./.sut first, then sibling checkouts.
#
# SUT_PATH=../../SRI-KO_LMS_MERN

# Used by `npm run sut:setup -- --clone`.
# SUT_GIT_REMOTE=https://github.com/TeamNova-SRI-KO-LMS/app.git
# SUT_GIT_REF=develop

# ── Integration test database ────────────────────────────────────────────────
# Leave unset and the suite boots a throw-away in-memory MongoDB, which needs
# no setup at all. Set it to use a real server instead — a CI service container,
# or a local Docker MongoDB. Each Jest worker is given its own database on the
# server, so this URI is a *base*, not the final connection string.
#
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/sriko_lms_test

# ── End-to-end suite ─────────────────────────────────────────────────────────
# E2E_FRONTEND_URL=http://localhost:5173
# E2E_BACKEND_URL=http://localhost:5001
# E2E_MONGODB_URI=mongodb://127.0.0.1:27017/sriko_lms_e2e
#
# Set to true to run against an already-running stack (staging, or your own
# terminals) instead of letting Playwright boot one.
# E2E_EXTERNAL=false

# ── Performance suite ────────────────────────────────────────────────────────
# PERF_BASE_URL=http://localhost:5001

# ── Diagnostics ──────────────────────────────────────────────────────────────
# The application logs heavily; the harness silences it so assertion failures
# stay readable. Set this to true when an integration test fails for a reason
# the assertion does not explain.
# SUT_VERBOSE=false

# Keep the real rate limiter attached in the functional suites. Off by default
# so a long test file cannot start receiving 429s unrelated to what it tests;
# the security suite verifies the limiter separately either way.
# RATE_LIMIT_IN_TESTS=false
